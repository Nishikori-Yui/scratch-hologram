{
  "name": "scratch-hologram",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:wasm && vite --host 127.0.0.1",
    "build:wasm": "node scripts/build-wasm.mjs",
    "build": "npm run build:wasm && vite build",
    "test": "cargo test --manifest-path wasm/Cargo.toml && node --test tests/wasm.test.mjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": { "vue": "^3.5.22" },
  "devDependencies": { "@vitejs/plugin-vue": "^6.0.1", "vite": "^7.1.9" }
}
